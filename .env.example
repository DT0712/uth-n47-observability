# =====================================================================================
#  Cấu hình lab — copy thành .env rồi chỉnh:   Copy-Item .env.example .env   (PowerShell)
#                                              cp .env.example .env          (WSL/Linux)
#  CHỈ dùng giá trị giả cho lab local. KHÔNG đưa mật khẩu/khoá thật vào đây hay vào git.
#  Các giá trị "change-me-*" phải được đổi nếu lab được mở cho người khác truy cập.
# =====================================================================================

# --- Máy ảo (Vagrantfile đọc các biến này) -------------------------------------------
LAB_BOX=bento/ubuntu-24.04
VM_MONITOR_IP=192.168.56.10
VM_MONITOR_MEMORY=4096
VM_MONITOR_CPUS=2
VM_WEB_IP=192.168.56.11
VM_WEB_MEMORY=1024
VM_WEB_CPUS=1
VM_DB_IP=192.168.56.12
VM_DB_MEMORY=1536
VM_DB_CPUS=1

# Cổng forward từ VM monitor ra Windows host (chỉ bind 127.0.0.1)
# 8080 hay bị phần mềm khác trên Windows chiếm nên mặc định dùng 18080 (portal trong VM vẫn nghe 8080)
HOST_PORT_PORTAL=18080
HOST_PORT_GRAFANA=3000
HOST_PORT_PROMETHEUS=9090
HOST_PORT_ALERTMANAGER=9093

# Ổ đĩa giả lập dung lượng giới hạn trên mỗi VM (file loop gắn tại /mnt/labdisk), đơn vị MB
LAB_DISK_SIZE_MB=512

# --- Giám sát ------------------------------------------------------------------------
PROM_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-lab-only
# Viewer ẩn danh để portal nhúng panel Grafana (chỉ chấp nhận trong lab, xem ADR-0008)
GRAFANA_ANONYMOUS_ENABLED=true

# --- CSDL của ứng dụng demo (VM db) ----------------------------------------------------
LAB_DB_NAME=demoapp
LAB_DB_USER=demoapp
LAB_DB_PASSWORD=change-me-lab-only
# User chỉ-đọc cho postgres-exporter
POSTGRES_EXPORTER_PASSWORD=change-me-lab-only

# --- Web portal (VM monitor, CSDL riêng — xem ADR-0005) --------------------------------
PORTAL_DB_PASSWORD=change-me-lab-only
# Sinh chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_JWT_SECRET=change-me-generate-a-random-string
PORTAL_JWT_EXPIRE_MINUTES=60
# Tài khoản admin đầu tiên, tạo lúc khởi động lần đầu
PORTAL_BOOTSTRAP_ADMIN_USER=admin
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=change-me-lab-only
