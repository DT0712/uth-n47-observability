# Copy file này thành .env rồi chỉnh nếu cần:  copy .env.example .env   (PowerShell: Copy-Item .env.example .env)
# KHÔNG đưa credential thật vào đây. Đây chỉ là giá trị cho lab chạy local.
# Nếu không có .env, docker-compose.yml vẫn chạy với các giá trị mặc định giống bên dưới.

# Grafana (chỉ dùng trong lab local)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-lab-only
GRAFANA_ANONYMOUS_ENABLED=true

# Thời gian lưu dữ liệu metric (lịch sử)
PROM_RETENTION=15d

# Dung lượng ổ đĩa lab giới hạn (tmpfs) cho kịch bản disk đầy — chiếm RAM tương ứng
LAB_DISK_SIZE=256m

# Tải sinh ra bởi traffic-generator (request/giây, tổng cho cả 3 dịch vụ)
LOADGEN_RPS=5

# Cổng trên máy host (chỉ bind 127.0.0.1)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8088
BLACKBOX_PORT=9115
SVC_API_PORT=8001
SVC_ORDERS_PORT=8002
SVC_PAYMENTS_PORT=8003
WEBHOOK_PORT=5001
