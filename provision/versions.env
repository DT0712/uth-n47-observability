# Phiên bản ghim cho provisioning (ADR-0003). Đổi phiên bản = sửa ở đây rồi `vagrant provision`.
# Checksum tải về được đối chiếu với file sha256sums.txt của chính bản phát hành.

NODE_EXPORTER_VERSION=1.8.2

# Docker Engine trên VM monitor (gói apt từ download.docker.com, Ubuntu 24.04 noble)
DOCKER_CE_VERSION=5:27.3.1-1~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=2.29.7-1~ubuntu.24.04~noble

# PostgreSQL lấy từ kho Ubuntu 24.04 (bản 16)
POSTGRES_MAJOR=16

# Exporter dịch vụ (GĐ2)
NGINX_EXPORTER_VERSION=1.3.0
POSTGRES_EXPORTER_VERSION=0.15.0
